# Copy to .env.companion. Values stay on this computer, never sent to the browser.
# Or reference your existing local MiniMax env file. Keep credentials in that file.
MINIMAX_CONFIG_FILE=
MINIMAX_API_KEY=
# Optional separate keys for text and speech accounts.
MINIMAX_CHAT_API_KEY=
MINIMAX_SPEECH_API_KEY=
MINIMAX_API_BASE=https://api.minimax.cn
MINIMAX_CHAT_MODEL=MiniMax-M3
# M3 supports disabled/adaptive. This does not disable thinking on M2.x.
MINIMAX_CHAT_THINKING=disabled
MINIMAX_CHAT_URL=
# Choose a female voice from your MiniMax account. Accent depends on the voice.
MINIMAX_VOICE_ID=Chinese (Mandarin)_Warm_Girl
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_TTS_URL=
